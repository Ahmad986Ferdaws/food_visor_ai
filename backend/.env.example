# App
APP_ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://foodvisor:foodvisor_dev@postgres:5432/foodvisor

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# CORS
FRONTEND_URL=http://localhost:3000

# Agents
AGENT1_MODEL_PROVIDER=anthropic
AGENT1_API_KEY=sk-CHANGE_ME
AGENT2_MODEL_PROVIDER=anthropic
AGENT2_API_KEY=sk-CHANGE_ME
AGENT3_MODEL_PROVIDER=anthropic
AGENT3_API_KEY=sk-CHANGE_ME

# Embedding
EMBEDDING_MODEL_PROVIDER=nvidia
EMBEDDING_API_KEY=nvapi-CHANGE_ME
EMBEDDING_MODEL_NAME=nvidia/nv-embed-v2
EMBEDDING_DIMENSION=1024

# RAG
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Timeouts
AGENT_TIMEOUT=30
TASK_TIMEOUT=120
