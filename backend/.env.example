# App
APP_ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://foodvisor:foodvisor_dev@postgres:5432/foodvisor

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# CORS
FRONTEND_URL=http://localhost:3000

# Agent 1 — Context Builder (Anthropic Claude)
AGENT1_MODEL_PROVIDER=anthropic
AGENT1_MODEL_NAME=claude-sonnet-4-6
AGENT1_API_KEY=sk-ant-CHANGE_ME

# Agent 2 — Recommender (OpenAI)
AGENT2_MODEL_PROVIDER=openai
AGENT2_MODEL_NAME=gpt-5.4
AGENT2_API_KEY=sk-CHANGE_ME

# Agent 3 — Validator (Anthropic Claude)
AGENT3_MODEL_PROVIDER=anthropic
AGENT3_MODEL_NAME=claude-sonnet-4-6
AGENT3_API_KEY=sk-ant-CHANGE_ME

# Embeddings (OpenAI text-embedding-3-small, 1536 dim)
EMBEDDING_MODEL_PROVIDER=openai
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_API_KEY=sk-CHANGE_ME
EMBEDDING_DIMENSION=1536

# RAG
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Timeouts
AGENT_TIMEOUT=30
TASK_TIMEOUT=120
