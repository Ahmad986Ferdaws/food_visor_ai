# === App ===
APP_ENV=development
LOG_LEVEL=INFO

# === Database ===
DATABASE_URL=postgresql+asyncpg://foodvisor:foodvisor@postgres:5432/foodvisor
DATABASE_URL_SYNC=postgresql://foodvisor:foodvisor@postgres:5432/foodvisor

# === Redis / Celery ===
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# === Agent 1: Context Builder ===
AGENT1_MODEL_PROVIDER=openai
AGENT1_API_KEY=sk-CHANGE_ME

# === Agent 2: Recommender ===
AGENT2_MODEL_PROVIDER=openai
AGENT2_API_KEY=sk-CHANGE_ME

# === Agent 3: Validator ===
AGENT3_MODEL_PROVIDER=openai
AGENT3_API_KEY=sk-CHANGE_ME

# === Embeddings ===
EMBEDDING_API_KEY=sk-CHANGE_ME
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# === Reranker (optional) ===
RERANKER_API_KEY=
RERANKER_MODEL=
